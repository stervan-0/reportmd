{
  "document": {
    "paper": "a4",
    "title": "",
    "author": ""
  },
  "page": {
    "margin": {
      "top": "25mm",
      "bottom": "25mm",
      "left": "25mm",
      "right": "25mm"
    },
    "numbering": true
  },
  "text": {
    "font_size": "10.5pt",
    "line_spacing": 1.5,
    "paragraph_indent": 1
  },
  "font": {
    "main": "IPAexMincho",
    "mono": "Noto Sans Mono CJK JP"
  },
  "heading": {
    "font": "IPAexGothic",
    "bold": true,
    "sizes": ["14pt", "12pt", "10.5pt"],
    "indents": [0, 1, 2]
  },
  "caption": {
    "figure_label": "図",
    "table_label": "表",
    "figure_position": "bottom",
    "table_position": "top"
  },
  "table": {
    "position": "center",
    "width": "auto",
    "font_size": null,
    "row_spacing": 1.3,
    "cell_padding": "6pt",
    "header": {
      "bold": false,
      "align": "center"
    },
    "rules": {
      "top": "0.8pt",
      "header": "1.2pt",
      "bottom": "0.8pt",
      "rows": false,
      "vertical": false,
      "sides": false
    }
  },
  "equation": {
    "numbering": true,
    "label": "式"
  },
  "cover": {
    "layout": [
      { "space": "40mm" },
      { "text": "{title}", "size": "24pt", "bold": true },
      { "space": "8mm" },
      { "text": "{副題}", "size": "14pt" },
      { "space": "fill" },
      {
        "fields": [
          ["科目", "{科目}"],
          ["担当教員", "{担当教員}"],
          ["提出日", "{提出日}"],
          ["所属", "{所属}"],
          ["学籍番号", "{学籍番号}"],
          ["氏名", "{author}"]
        ],
        "size": "12pt"
      },
      { "space": "30mm" }
    ]
  }
}
