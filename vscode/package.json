{
  "name": "reportmd",
  "displayName": "reportmd",
  "description": "reportmd（Markdown で大学のレポートを書いて PDF にするツール）の色分け・エラー表示・PDF の生成とプレビュー",
  "version": "0.1.0",
  "publisher": "reportmd",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:reportmd",
    "onWebviewPanel:reportmd.preview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "reportmd.preview",
        "title": "プレビューを横に表示",
        "category": "reportmd",
        "icon": "$(open-preview)"
      },
      {
        "command": "reportmd.build",
        "title": "PDF を生成",
        "category": "reportmd",
        "icon": "$(file-pdf)"
      },
      {
        "command": "reportmd.watch",
        "title": "監視を開始（変更のたびに PDF を生成）",
        "category": "reportmd",
        "icon": "$(eye)"
      },
      {
        "command": "reportmd.stopWatch",
        "title": "監視を停止",
        "category": "reportmd",
        "icon": "$(debug-stop)"
      },
      {
        "command": "reportmd.check",
        "title": "誤りを調べる",
        "category": "reportmd"
      },
      {
        "command": "reportmd.showOutput",
        "title": "出力を表示",
        "category": "reportmd"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "reportmd.preview",
          "when": "resourceLangId == reportmd",
          "group": "navigation@0"
        },
        {
          "command": "reportmd.build",
          "when": "resourceLangId == reportmd",
          "group": "navigation@1"
        },
        {
          "command": "reportmd.watch",
          "when": "resourceLangId == reportmd && !reportmd.watching",
          "group": "navigation@2"
        },
        {
          "command": "reportmd.stopWatch",
          "when": "resourceLangId == reportmd && reportmd.watching",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "reportmd.preview",
          "when": "resourceExtname == .reportmd",
          "group": "reportmd@0"
        },
        {
          "command": "reportmd.build",
          "when": "resourceExtname == .reportmd",
          "group": "reportmd@1"
        },
        {
          "command": "reportmd.watch",
          "when": "resourceExtname == .reportmd",
          "group": "reportmd@2"
        }
      ],
      "commandPalette": [
        {
          "command": "reportmd.preview",
          "when": "editorLangId == reportmd"
        },
        {
          "command": "reportmd.build",
          "when": "editorLangId == reportmd"
        },
        {
          "command": "reportmd.watch",
          "when": "editorLangId == reportmd && !reportmd.watching"
        },
        {
          "command": "reportmd.stopWatch",
          "when": "editorLangId == reportmd && reportmd.watching"
        },
        {
          "command": "reportmd.check",
          "when": "editorLangId == reportmd"
        }
      ]
    },
    "configuration": {
      "title": "reportmd",
      "properties": {
        "reportmd.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "reportmd コマンドのパス。空なら `reportmd`（PATH から探す。見つからなければ `~/.local/bin/reportmd`）。Windows で WSL のフォルダを開いている場合は、WSL の中のパスを書く",
          "scope": "machine-overridable"
        },
        "reportmd.checkOnSave": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "保存するたびに `reportmd check` を実行し、エラー・警告を表示する（監視中は、監視の結果を表示する）"
        },
        "reportmd.openPdf": {
          "type": "string",
          "enum": [
            "preview",
            "external",
            "none"
          ],
          "enumDescriptions": [
            "VS Code の横のプレビューに表示する",
            "PDF ビューア（OS の既定のアプリ）で開く",
            "開かない"
          ],
          "default": "preview",
          "description": "「PDF を生成」「監視を開始」で生成した PDF をどこで開くか"
        },
        "reportmd.liveUpdate": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "プレビュー・監視の間は、保存しなくても、入力するたびに PDF を生成し直す（保存していない内容を `reportmd watch --stdin` に送る）。オフにすると、保存したときだけ生成し直す"
        },
        "reportmd.liveUpdateDelay": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "markdownDescription": "入力が止まってから、生成し直すまでの時間（ミリ秒）。`reportmd.liveUpdate` が有効なときに使う"
        }
      }
    },
    "languages": [
      {
        "id": "reportmd",
        "aliases": [
          "reportmd"
        ],
        "extensions": [
          ".reportmd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "setting.json",
        "url": "./schemas/setting.schema.json"
      }
    ],
    "grammars": [
      {
        "language": "reportmd",
        "scopeName": "text.reportmd",
        "path": "./syntaxes/reportmd.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.math.reportmd": "latex"
        }
      },
      {
        "scopeName": "text.reportmd.inline",
        "path": "./syntaxes/reportmd.injection.tmLanguage.json",
        "injectTo": [
          "text.reportmd"
        ]
      }
    ]
  },
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs.js",
    "vscode:prepublish": "node scripts/copy-pdfjs.js",
    "test": "node --test \"test/**/*.test.js\"",
    "package": "npx --yes @vscode/vsce@3 package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "pdfjs-dist": "^6.4.299",
    "vscode-json-languageservice": "^5.7.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
