{
  "brackets": [
    ["[", "]"],
    ["(", ")"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "`", "close": "`", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["{", "}"],
    ["`", "`"],
    ["*", "*"],
    ["_", "_"],
    ["$", "$"]
  ],
  "wordPattern": "(@?[A-Za-z0-9_][A-Za-z0-9_:.\\-]*)|([^\\s`~!@#$%^&*()=+\\[{\\]}\\\\|;:'\",.<>/?]+)"
}
