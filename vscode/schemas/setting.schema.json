{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "reportmd の設定ファイル（setting.json）",
  "description": "書かなかった項目は既定値になります。項目の一覧は reportmd の仕様書の7章を参照してください。",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "length": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?(mm|cm|pt|in)$",
      "patternErrorMessage": "単位つきの長さ（例：\"25mm\"。単位は mm cm pt in）"
    },
    "point": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?pt$",
      "patternErrorMessage": "\"6pt\"〜\"24pt\" の文字サイズ",
      "examples": ["9pt", "10pt", "10.5pt", "11pt", "12pt", "14pt"]
    },
    "font": {
      "type": "string",
      "pattern": "^[^{}\\\\%#&$^_~]+$",
      "patternErrorMessage": "空でないフォント名。{ } \\ % # & $ ^ _ ~ は使えません（使えるフォント名は reportmd fonts で確認できます）",
      "examples": ["IPAexMincho", "IPAexGothic", "Noto Serif CJK JP", "Noto Sans CJK JP", "Noto Sans Mono CJK JP"]
    },
    "indent": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "rule": {
      "description": "線の太さ（例：\"0.5pt\"）。false なら線を引かない",
      "oneOf": [
        { "const": false },
        { "$ref": "#/definitions/length" }
      ]
    },
    "position": {
      "type": "string",
      "enum": ["top", "bottom"],
      "enumDescriptions": ["上", "下"]
    },
    "coverText": {
      "type": "string",
      "pattern": "^(?:[^{}]|\\{\\{|\\}\\}|\\{[^{}]*[^{}\\s][^{}]*\\})*$",
      "patternErrorMessage": "{ と } の対応が取れていません（{名前} で値を差し込みます。文字の { } は {{ }} と書きます）"
    },
    "coverItem": {
      "type": "object",
      "additionalProperties": false,
      "defaultSnippets": [
        { "label": "文字", "body": { "text": "$1" } },
        { "label": "空き", "body": { "space": "${1:20mm}" } },
        { "label": "項目の表", "body": { "fields": [["${1:氏名}", "${2:{author\\}}"]] } }
      ],
      "properties": {
        "text": { "description": "1行の文字。{名前} でフロントマターの値を差し込む", "$ref": "#/definitions/coverText" },
        "space": {
          "description": "縦の空き。\"fill\" は残りの空きを埋める（複数あれば等分する）",
          "oneOf": [
            { "const": "fill" },
            { "$ref": "#/definitions/length" }
          ]
        },
        "fields": {
          "description": "[\"項目名\", \"値\"] の組の配列。項目名をそろえた表にする。値が空の行は出さない",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "$ref": "#/definitions/coverText" }
          }
        },
        "align": {
          "description": "揃え（既定は center）",
          "type": "string",
          "enum": ["center", "left", "right"],
          "enumDescriptions": ["中央", "左", "右"]
        },
        "size": {
          "description": "文字サイズ（\"6pt\"〜\"72pt\"。既定は本文と同じ）",
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?pt$",
          "patternErrorMessage": "\"6pt\"〜\"72pt\" の文字サイズ",
          "examples": ["12pt", "14pt", "18pt", "24pt", "32pt"]
        },
        "bold": { "description": "太字にするか（既定は false）", "type": "boolean" }
      },
      "oneOf": [
        { "required": ["text"] },
        { "required": ["space"] },
        { "required": ["fields"] }
      ]
    }
  },
  "properties": {
    "document": {
      "description": "文書",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paper": {
          "description": "用紙の大きさ",
          "type": "string",
          "enum": ["a4", "a5", "b5", "letter"],
          "default": "a4"
        },
        "title": {
          "description": "PDF のメタデータのタイトル（文書のフロントマターの title が優先）",
          "type": "string",
          "default": ""
        },
        "author": {
          "description": "PDF のメタデータの著者（文書のフロントマターの author が優先）",
          "type": "string",
          "default": ""
        }
      }
    },
    "page": {
      "description": "ページ",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "margin": {
          "description": "余白",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": { "description": "上の余白", "$ref": "#/definitions/length", "default": "25mm" },
            "bottom": { "description": "下の余白", "$ref": "#/definitions/length", "default": "25mm" },
            "left": { "description": "左の余白", "$ref": "#/definitions/length", "default": "25mm" },
            "right": { "description": "右の余白", "$ref": "#/definitions/length", "default": "25mm" }
          }
        },
        "numbering": {
          "description": "ページ番号を付けるか（下中央に表示）",
          "type": "boolean",
          "default": true
        }
      }
    },
    "text": {
      "description": "本文",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font_size": { "description": "本文の文字サイズ（\"6pt\"〜\"24pt\"）", "$ref": "#/definitions/point", "default": "10.5pt" },
        "line_spacing": {
          "description": "行間（文字サイズに対する倍率。1.0〜3.0）",
          "type": "number",
          "minimum": 1,
          "maximum": 3,
          "default": 1.5
        },
        "paragraph_indent": {
          "description": "段落の既定の字下げ（単位は字。0〜5）。行頭に半角スペース2個を書いた段落は、この値にかかわらず1字",
          "$ref": "#/definitions/indent",
          "default": 1
        }
      }
    },
    "font": {
      "description": "フォント（使えるフォント名は reportmd fonts で確認できます）",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "main": { "description": "本文のフォント", "$ref": "#/definitions/font", "default": "IPAexMincho" },
        "mono": { "description": "コード（等幅）のフォント", "$ref": "#/definitions/font", "default": "Noto Sans Mono CJK JP" }
      }
    },
    "heading": {
      "description": "見出し（#1 #2 #3）",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font": { "description": "見出しのフォント", "$ref": "#/definitions/font", "default": "IPAexGothic" },
        "bold": { "description": "見出しを太字にするか", "type": "boolean", "default": true },
        "sizes": {
          "description": "見出しの文字サイズ（#1 #2 #3 の順に3個。\"6pt\"〜\"24pt\"）",
          "type": "array",
          "items": { "$ref": "#/definitions/point" },
          "minItems": 3,
          "maxItems": 3,
          "default": ["14pt", "12pt", "10.5pt"]
        },
        "indents": {
          "description": "見出しの字下げ（#1 #2 #3 の順に3個。単位は字。0〜5）",
          "type": "array",
          "items": { "$ref": "#/definitions/indent" },
          "minItems": 3,
          "maxItems": 3,
          "default": [0, 1, 2]
        }
      }
    },
    "caption": {
      "description": "図表のキャプション",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "figure_label": { "description": "図の番号の前の文字（「図1」の「図」）", "type": "string", "default": "図" },
        "table_label": { "description": "表の番号の前の文字（「表1」の「表」）", "type": "string", "default": "表" },
        "figure_position": { "description": "図のキャプションの位置", "$ref": "#/definitions/position", "default": "bottom" },
        "table_position": { "description": "表のキャプションの位置", "$ref": "#/definitions/position", "default": "top" }
      }
    },
    "table": {
      "description": "表の書式",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "description": "表の配置",
          "type": "string",
          "enum": ["center", "left"],
          "enumDescriptions": ["中央", "左寄せ"],
          "default": "center"
        },
        "width": {
          "description": "表の幅",
          "type": "string",
          "enum": ["auto", "full"],
          "enumDescriptions": ["内容に合わせる", "本文幅いっぱい"],
          "default": "auto"
        },
        "font_size": {
          "description": "表の中の文字サイズ（null なら本文と同じ）",
          "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/point" }],
          "default": null
        },
        "row_spacing": {
          "description": "行の高さ（倍率。1.0〜3.0）",
          "type": "number",
          "minimum": 1,
          "maximum": 3,
          "default": 1.3
        },
        "cell_padding": { "description": "セルの左右の余白", "$ref": "#/definitions/length", "default": "6pt" },
        "header": {
          "description": "見出し行",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bold": { "description": "見出し行を太字にするか", "type": "boolean", "default": false },
            "align": {
              "description": "見出し行の揃え",
              "type": "string",
              "enum": ["center", "left", "right", "column"],
              "enumDescriptions": ["中央", "左", "右", "列の揃えに従う"],
              "default": "center"
            }
          }
        },
        "rules": {
          "description": "罫線の太さ（false で線を引かない）",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": { "description": "上端の線", "$ref": "#/definitions/rule", "default": "0.8pt" },
            "header": { "description": "見出し行の下の線", "$ref": "#/definitions/rule", "default": "1.2pt" },
            "bottom": { "description": "下端の線", "$ref": "#/definitions/rule", "default": "0.8pt" },
            "rows": { "description": "行の間の線", "$ref": "#/definitions/rule", "default": false },
            "vertical": { "description": "列の間の線", "$ref": "#/definitions/rule", "default": false },
            "sides": { "description": "左右の端の線", "$ref": "#/definitions/rule", "default": false }
          }
        }
      }
    },
    "equation": {
      "description": "数式（$$ … $$）",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numbering": { "description": "独立した数式に番号を付けるか", "type": "boolean", "default": true },
        "label": { "description": "数式の参照の前の文字（@名前 が「式(1)」になるときの「式」）", "type": "string", "default": "式" }
      }
    },
    "cover": {
      "description": "表紙（文書のフロントマターに cover を書くと付く）",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {
          "description": "表紙の項目を上から順に並べた配列。text（1行の文字）・space（縦の空き）・fields（項目名と値の表）のどれか1つを書く。文字の {名前} には、フロントマターの cover の値（{title} と {author} はフロントマターの値）が入り、値がどれも空の行は出さない",
          "type": "array",
          "items": { "$ref": "#/definitions/coverItem" },
          "default": [
            { "space": "40mm" },
            { "text": "{title}", "size": "24pt", "bold": true },
            { "space": "8mm" },
            { "text": "{副題}", "size": "14pt" },
            { "space": "fill" },
            {
              "fields": [
                ["科目", "{科目}"],
                ["担当教員", "{担当教員}"],
                ["提出日", "{提出日}"],
                ["所属", "{所属}"],
                ["学籍番号", "{学籍番号}"],
                ["氏名", "{author}"]
              ],
              "size": "12pt"
            },
            { "space": "30mm" }
          ]
        }
      }
    }
  }
}
